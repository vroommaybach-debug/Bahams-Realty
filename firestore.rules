rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Properties collection: Public read for property seekers; write permitted for catalog management
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if isValidId(propertyId);
    }

    // Enquiries collection: Public create for site visitors submitting viewing / consultation requests; read/update for operational management
    match /enquiries/{enquiryId} {
      allow read: if true;
      allow create: if isValidId(enquiryId);
      allow update, delete: if isValidId(enquiryId);
    }

    // Settings / Landing CMS configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Default fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
